#!/usr/bin/env bash
# Pre-Commit: Secrets-Scan (gitleaks) + PHP-Lint auf 8.1 + JS-Unit-Tests – alles über Docker.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export UID GID="$(id -g)"
dc() { docker compose --profile tools run --rm -T "$@"; }

dc gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml

mapfile -t php_files < <(git diff --cached --name-only --diff-filter=ACM -- '*.php')
if ((${#php_files[@]})); then
  dc php sh -c 'for f; do php -l "$f" >/dev/null || exit 1; done' _ "${php_files[@]}"
fi

if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.(js|mjs)$'; then
  node --test tests/js/ >/dev/null
fi
echo "✔ pre-commit: gitleaks, php -l (8.1), JS-Tests ok"
